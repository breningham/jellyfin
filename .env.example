# One-time, reusable Tailscale auth key for first enrollment. Node identity is
# persisted in the jellyfin_tailscale_state volume, so this can be removed
# after the first successful start.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Only needed if the tailnet policy requires tags for the enrollment start.
#TS_EXTRA_ARGS=--advertise-tags=tag:container

# Tailnet node name and tailnet domain (used for the published server URL).
#TS_HOSTNAME=jellyfin
#TS_TAILNET=tail86146.ts.net

# Host media root, mounted read-only at /media in the container.
#MEDIA_DIR=/opt/media

#TZ=Europe/London

# uid/gid the xtream-sync container runs as, so its output is owned by you.
# `make` sets these from `id`; only needed if calling podman-compose directly.
#PUID=1000
#PGID=1000

# Xtream IPTV provider, used by the xtream-sync sidecar. Host is the base URL
# with no path. Several mirror URLs may be given, comma-separated; each run
# probes them and uses the healthiest (sticking with the current one unless
# another is at least 30% faster).
XTREAM_HOST=http://provider.example,http://mirror.provider.example
XTREAM_USERNAME=user
XTREAM_PASSWORD=pass

# Jellyfin API key (Dashboard -> API Keys). If set, xtream-sync asks Jellyfin
# to rescan libraries after each run.
#JELLYFIN_API_KEY=

# Seconds between sync runs (default 6 hours).
#XTREAM_SYNC_INTERVAL=21600

# Path of the layout rules inside the sidecar (config/xtream/layout.yaml).
#XTREAM_LAYOUT=/config/layout.yaml
